<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        MinWidth="338" MinHeight="238"
        mc:Ignorable="d" CanMaximize="False" CanResize="False"
        x:Class="AvDeviceManager.AddDevice"
        Width="512" Height="400" Icon="Assets\mas_devmgr.png"
        CanMinimize="False"
        ShowInTaskbar="False"
        Title="Lisa seade">
        <Grid RowDefinitions="128,Auto,Auto,*,Auto" ColumnDefinitions="Auto,*" ColumnSpacing="10" RowSpacing="10" Margin="10, 0" Name="FullGrid">
                <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="20" Margin="15">
                        <Image Source="Assets/mas_devmgr.png" Width="128" Height="128"></Image>
                        <TextBlock TextAlignment="Center" VerticalAlignment="Center" Text="Lisa seade" FontSize="20"></TextBlock>
                </StackPanel>
                <Label Grid.Row="1" Grid.Column="0" VerticalAlignment="Center">IP aadress</Label>
                <TextBox Name="DevIpTextbox" PlaceholderText="4 segmendiga, nt 127.0.0.1" Grid.Row="1" Grid.Column="1" TextChanged="DevIpTextbox_OnTextChanged"></TextBox>
                <Label Grid.Row="2" Grid.Column="0" VerticalAlignment="Center">Seadme tüüp</Label>
                <ComboBox Name="DevTypeComboBox" Grid.Row="2" Grid.Column="1" Width="389" SelectionChanged="DevTypeComboBox_OnSelectionChanged">
                        <ComboBox.Items>
                                <ComboBoxItem>Markuse arvuti (mas)</ComboBoxItem>
                                <ComboBoxItem>Markuse virtuaalarvuti (masv)</ComboBoxItem>
                                <ComboBoxItem>Markuse tahvelarvuti (mta)</ComboBoxItem>
                                <ComboBoxItem>Markuse arvuti Linuxiga (masl)</ComboBoxItem>
                                <ComboBoxItem>Markuse telefon (mtel)</ComboBoxItem>
                                <ComboBoxItem>Markuse asjad muudelete seadmetele (mat)</ComboBoxItem>
                                <ComboBoxItem>Puhverserver (clf)</ComboBoxItem>
                        </ComboBox.Items>
                </ComboBox>
                <TextBlock TextWrapping="Wrap" Grid.Column="0" Grid.Row="3" Grid.ColumnSpan="2">
                        Seadme IP aadressi leiate võrguseadetest. Pange tähele, et siin tuleb kasutada kohalikku IP aadressi, mitte võrguala IP (v.a. kui seadme tüüp on "Puhverserver") 
                        <LineBreak /><LineBreak />
                        Telefone ja tahvelarvuteid saab siduda integratsiooni ja M.A.I.A. rakenduste kaudu kasutades ühekordse PIN koodiga autentimist.
                </TextBlock>
                <WrapPanel Grid.Row="4" Grid.Column="1" HorizontalAlignment="Right" ItemSpacing="10" LineSpacing="10" Margin="0,10">
                        <Button Click="OnCancel">Loobu</Button>
                        <Button Name="AddDeviceButton" Click="OnAddDevice" IsEnabled="False">Lisa seade</Button>
                </WrapPanel>
        </Grid>
</Window>
