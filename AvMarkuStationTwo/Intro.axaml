<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="AvMarkuStationTwo.Intro" Background="Black"
        Title="Intro">
    <Panel>
        <Ellipse Width="800" Height="600">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <RadialGradientBrush.GradientStops>
                        <GradientStop Color="DeepSkyBlue" Offset="0"></GradientStop>
                        <GradientStop Color="Black" Offset="1.0"></GradientStop>
                    </RadialGradientBrush.GradientStops>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>
        <Ellipse Margin="80, 0,0 0" Width="400" Height="400">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <RadialGradientBrush.GradientStops>
                        <GradientStop Color="DeepSkyBlue" Offset="0"></GradientStop>
                        <GradientStop Color="Transparent" Offset="1.0"></GradientStop>
                    </RadialGradientBrush.GradientStops>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>
        <TextBlock  Foreground="White" FontSize="64" FontFamily="Segoe UI" HorizontalAlignment="Center" VerticalAlignment="Center" Text="Markuse arvuti meelelahutus" />
    </Panel>
</Window>
