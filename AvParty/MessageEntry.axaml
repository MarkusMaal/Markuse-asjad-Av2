<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" Width="400" Height="120"
        x:Class="AvParty.MessageEntry"
        Title="Isikupärastatud teade" WindowStartupLocation="CenterScreen" Loaded="Window_Loaded_2">
    <StackPanel Margin="20" VerticalAlignment="Center">
        <Label>Sisesta teade</Label>
        <TextBox Name="MessageField" KeyDown="TextBox_KeyDown" ></TextBox>
        <Button HorizontalAlignment="Right" Margin="0,10" Padding="20,5" Click="OK_Click">OK</Button>
    </StackPanel>
</Window>
