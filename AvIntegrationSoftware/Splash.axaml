<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="AvIntegrationSoftware.Splash"
        Title="Splash"
        Topmost="True"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="-1"
        WindowDecorations="BorderOnly"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        IsHitTestVisible="True" CanResize="False" BorderThickness="0"
        Width="400" Height="245" WindowStartupLocation="CenterScreen"
        BorderBrush="Transparent" WindowState="Normal" ShowInTaskbar="False"
        Foreground="White" Loaded="Control_OnLoaded"
        Icon="Assets/mas_integration.png" DataContext="{Binding RelativeSource={RelativeSource Self}}">
    <Grid RowDefinitions="*,Auto,30">
        <Rectangle Grid.Row="0" Grid.RowSpan="3" Name="Backglass" Fill="#8009" Width="400" Height="245">

        </Rectangle>
        <Polygon Grid.Row="0" Grid.RowSpan="3" Points="0,0 400,0 0,245" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Polygon.Fill>
                <LinearGradientBrush StartPoint="200,0" EndPoint="200,245">
                    <GradientStop Offset="0.0" Color="#4fff"></GradientStop>
                    <GradientStop Offset="0.4" Color="Transparent"></GradientStop>
                </LinearGradientBrush>
            </Polygon.Fill>
        </Polygon>
        <Image Grid.Row="0" Source="Assets/mas_integration.png" Name="IntegrationPicutre" MaxWidth="150" RenderOptions.BitmapInterpolationMode="HighQuality"></Image>
        <TextBlock Grid.Row="1" FontFamily="Segoe UI,Ubuntu,sans-serif"
               FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"
               Margin="0,10" FontWeight="SemiLight" TextAlignment="Center"
               Name="DeviceLabel" TextWrapping="Wrap" Text=""></TextBlock>
        <Label Grid.Row="2" HorizontalAlignment="Center" FontSize="10" Content="{Binding Copyright}"></Label>
        <ProgressBar Grid.Row="2" IsIndeterminate="True" Value="1" Maximum="100" VerticalAlignment="Bottom"></ProgressBar>
        
    </Grid>
</Window>
