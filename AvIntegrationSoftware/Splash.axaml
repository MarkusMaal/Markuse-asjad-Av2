<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="AvIntegrationSoftware.Splash"
        Title="Splash"
        Topmost="True"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="-1"
        WindowDecorations="BorderOnly"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        IsHitTestVisible="True" CanResize="False" BorderThickness="0"
        Width="400" Height="245" WindowStartupLocation="CenterScreen"
        BorderBrush="Transparent" WindowState="Normal" ShowInTaskbar="False"
        Foreground="White"
        Icon="Assets/mas_general.png">
    <Grid>
        <Rectangle Name="Backglass" Fill="#8009" Width="400" Height="245">

        </Rectangle>
        <Polygon Points="0,0 400,0 0,245" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Polygon.Fill>
                <LinearGradientBrush StartPoint="200,0" EndPoint="200,245">
                    <GradientStop Offset="0.0" Color="#4fff"></GradientStop>
                    <GradientStop Offset="0.4" Color="Transparent"></GradientStop>
                </LinearGradientBrush>
            </Polygon.Fill>
        </Polygon>
        <StackPanel VerticalAlignment="Center">
            <Image Source="Assets/mas_general.png" Name="DevicePicture" MaxWidth="150"></Image>
            <Label FontFamily="Segoe UI,Ubuntu,sans-serif"
                   FontSize="30" HorizontalAlignment="Center"
                   Margin="0,10" FontWeight="SemiLight"
                   Name="DeviceLabel">markuse asjad</Label>
            <Label HorizontalAlignment="Center" FontSize="10">© Markus Maal 2026</Label>
        </StackPanel>
    </Grid>
</Window>
